generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  nickname      String?
  avatarUrl     String?  @map("avatar_url")
  loginProvider String   @default("email") @map("login_provider")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  lastLoginAt   DateTime? @map("last_login_at")

  membership     Membership?
  aiCredits      AiCredits?
  works          Work[]
  aiJobs         AiJob[]
  uploadedImages UploadedImage[]

  @@index([email])
  @@map("users")
}

model Membership {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     String   @default("free")
  status    String   @default("active")
  startedAt DateTime @default(now()) @map("started_at")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("memberships")
}

model AiCredits {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyTotal   Int      @default(5) @map("daily_total")
  dailyUsed    Int      @default(0) @map("daily_used")
  extraCredits Int      @default(0) @map("extra_credits")
  resetAt      DateTime @default(now()) @map("reset_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("ai_credits")
}

model Work {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String?
  sourceImageUrl  String?  @map("source_image_url")
  previewImageUrl String?  @map("preview_image_url")
  patternDataUrl  String?  @map("pattern_data_url")
  beadBrand       String?  @map("bead_brand")
  patternWidth    Int?     @map("pattern_width")
  patternHeight   Int?     @map("pattern_height")
  colorCount      Int?     @map("color_count")
  totalBeads      Int?     @map("total_beads")
  status          String   @default("draft")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("works")
}

model AiJob {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  presetId       String?  @map("preset_id")
  provider       String?
  status         String   @default("pending")
  sourceImageUrl String?  @map("source_image_url")
  resultImageUrl String?  @map("result_image_url")
  creditCost     Int      @default(1) @map("credit_cost")
  errorMessage   String?  @map("error_message")
  requestId      String?  @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@index([userId])
  @@index([status])
  @@map("ai_jobs")
}

model UploadedImage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String?
  fileUrl   String?  @map("file_url")
  fileName  String?  @map("file_name")
  mimeType  String?  @map("mime_type")
  size      Int?
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@map("uploaded_images")
}
