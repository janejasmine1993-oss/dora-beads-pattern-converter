# ===== 前端配置 =====

# AI 运行时模式
# 可选值：mock（模拟模式） | real（真实模式）
VITE_AI_RUNTIME_MODE=mock

# AI 服务商
# 可选值：mock | tencent-hunyuan | volcengine | aliyun | openai
VITE_AI_PROVIDER=mock

# 前端调用后端 API 的地址
VITE_API_BASE_URL=http://localhost:3001

# ===== 后端配置（仅在 server/.env.local 中使用，不要提交 GitHub）=====

# 腾讯混元生图（推荐）
# 获取方式：https://cloud.tencent.com/document/product/1668
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_AIART_ENDPOINT=aiart.tencentcloudapi.com
TENCENT_AIART_VERSION=2022-12-29

# 火山引擎（暂不支持）
VOLCENGINE_API_KEY=

# 阿里云通义万相（暂不支持）
ALIYUN_DASHSCOPE_API_KEY=

# OpenAI（暂不支持）
OPENAI_API_KEY=
