# ===== 前端配置 =====

# LITE_MODE：会员体验版（无数据库）
# 可选值：true（启用 LITE_MODE）| false（标准版，需要后端和数据库）
VITE_LITE_MODE=false

# 会员访问口令（仅在 LITE_MODE=true 时有效）
# 用户首次进入时需要输入此口令
# ⚠️  生产环境上线前必须修改为当期会员口令
VITE_MEMBER_ACCESS_CODE=member2024

# 口令版本号（格式：YYYY-MM，如 2026-06）
# 每次更换口令时必须同时修改此版本号，以强制用户重新输入
# 示例：6月为 2026-06，7月为 2026-07
VITE_ACCESS_CODE_VERSION=2026-06

# AI 运行时模式
# 可选值：mock（模拟模式） | real（真实模式）
VITE_AI_RUNTIME_MODE=mock

# AI 服务商
# 可选值：mock | tencent-hunyuan | volcengine | aliyun | openai
VITE_AI_PROVIDER=mock

# 前端调用后端 API 的地址
# 仅在 VITE_LITE_MODE=false 时需要
VITE_API_BASE_URL=http://localhost:3001

# ===== 后端配置（仅在 server/.env.local 中使用，不要提交 GitHub）=====

# 腾讯混元生图（推荐）
# 获取方式：https://cloud.tencent.com/document/product/1668
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
TENCENT_AIART_ENDPOINT=aiart.tencentcloudapi.com
TENCENT_AIART_VERSION=2022-12-29

# 火山引擎（暂不支持）
VOLCENGINE_API_KEY=

# 阿里云通义万相（暂不支持）
ALIYUN_DASHSCOPE_API_KEY=

# OpenAI（暂不支持）
OPENAI_API_KEY=
