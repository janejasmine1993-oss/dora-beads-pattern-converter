# 生产环境前端配置
# LITE_MODE 配置（会员体验版）
VITE_LITE_MODE=true

# ⚠️ 会员口令：部署前必须改为当期会员口令，不能使用测试口令 member2024
VITE_MEMBER_ACCESS_CODE=member2024

# ⚠️ 口令版本号：每次修改口令时必须同时更新此版本号
# 格式：YYYY-MM（如 2026-06 表示 6 月）
# 版本号不匹配时用户旧授权会失效，需重新输入新口令
VITE_ACCESS_CODE_VERSION=2026-06

# API 和认证
VITE_API_BASE_URL=/api
VITE_AUTH_MODE=real

# AI 配置（生产环境使用 Mock）
VITE_AI_RUNTIME_MODE=mock
VITE_AI_PROVIDER=mock
